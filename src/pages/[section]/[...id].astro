---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allEntries, formatDate, labels, type Entry } from '../../lib/content';
export async function getStaticPaths() { return (await allEntries()).map(entry => ({ params: { section: entry.data.kind, id: entry.id }, props: { entry } })); }
const { entry } = Astro.props as { entry: Entry };
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}><article class="post"><header class="post-header"><a class="eyebrow" href={`/${entry.data.kind}/`}>← {entry.data.kind}</a><div class="post-meta">{labels[entry.data.kind]} / <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time> / Sample content</div><h1>{entry.data.title}</h1><p class="lede">{entry.data.description}</p>{entry.data.author && <p>Book by {entry.data.author}</p>}<div class="tags">{entry.data.tags.join(' / ')}</div></header><div class="prose"><Content/></div><div class="post-end"><span>Thanks for reading.</span><a href={`/${entry.data.kind}/`}>More {entry.data.kind} →</a></div></article></Base>
