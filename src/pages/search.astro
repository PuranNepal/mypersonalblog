---
import Base from '../layouts/Base.astro';
import { allEntries, entryUrl, labels, formatDate } from '../lib/content';
const entries = (await allEntries()).map(e => ({ title: e.data.title, description: e.data.description, kind: e.data.kind, label: labels[e.data.kind], date: e.data.date.toISOString().slice(0,10), displayDate: formatDate(e.data.date), thumbnail: e.data.thumbnail, thumbnailAlt: e.data.thumbnailAlt, url: entryUrl(e), text: [e.data.title, e.data.description, ...e.data.tags, e.body].join(' ').toLowerCase() }));
const years = [...new Set(entries.map(e => e.date.slice(0,4)))].sort().reverse();
const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
---
<Base title="Search">
  <section class="page-intro"><p class="eyebrow">FOLLOW A THREAD</p><h1>Find something <em>interesting.</em></h1><p class="lede">Search articles, signals, and notes from the bookshelf.</p></section>
  <form class="search-form" role="search" id="search-form">
    <label for="query">What’s on your mind?</label><div class="search-input"><input id="query" name="q" type="search" placeholder="Try “probability” or “attention”" autocomplete="off"/><button type="submit">Search →</button></div>
    <fieldset class="type-filters"><legend>Content type</legend>{[['all','All'],['articles','Articles'],['signals','Signals'],['books','Books']].map(([value,label]) => <label><input type="radio" name="kind" value={value} checked={value === 'all'}/><span>{label}</span></label>)}</fieldset>
    <div class="date-heading"><label for="date-mode">Filter by date<select id="date-mode" name="mode"><option value="calendar">Year / month</option><option value="range">Custom date range</option></select></label><button class="clear-filters" type="reset">Clear Filters</button></div>
    <fieldset id="calendar-filters" class="date-fields"><legend class="sr-only">Year and month</legend><label for="year">Year<select id="year" name="year"><option value="">Any year</option>{years.map(year => <option value={year}>{year}</option>)}</select></label><label for="month">Month<select id="month" name="month"><option value="">Any month</option>{months.map((month,index) => <option value={String(index+1).padStart(2,'0')}>{month}</option>)}</select></label></fieldset>
    <fieldset id="range-filters" class="date-fields" hidden disabled><legend class="sr-only">Custom date range</legend><label for="start">Start date<input id="start" name="start" type="date"/></label><label for="end">End date<input id="end" name="end" type="date"/></label></fieldset>
    <p class="date-help">Dates refer to website publication, or when a book recommendation was added. Range endpoints are included.</p><p id="date-error" role="alert" hidden>Start date must be on or before end date.</p>
  </form>
  <p id="search-status" role="status" aria-live="polite"></p><div id="results" class="search-results"></div>
  <noscript><p>Search needs JavaScript. You can browse <a href="/articles/">Articles</a>, <a href="/signals/">Signals</a>, and <a href="/books/">Books</a> instead.</p></noscript>
  <script id="search-data" type="application/json" set:html={JSON.stringify(entries).replace(/</g,'\\u003c')}/>
  <script>
    import { filterEntries, type SearchFilters } from '../lib/search';
    interface Entry { title: string; description: string; kind: string; label: string; date: string; displayDate: string; thumbnail?: string; thumbnailAlt?: string; url: string; text: string }
    const entries: Entry[] = JSON.parse(document.querySelector('#search-data')!.textContent!);
    const form = document.querySelector<HTMLFormElement>('#search-form')!;
    const input = document.querySelector<HTMLInputElement>('#query')!;
    const mode = document.querySelector<HTMLSelectElement>('#date-mode')!;
    const year = document.querySelector<HTMLSelectElement>('#year')!;
    const month = document.querySelector<HTMLSelectElement>('#month')!;
    const start = document.querySelector<HTMLInputElement>('#start')!;
    const end = document.querySelector<HTMLInputElement>('#end')!;
    const calendarFields = document.querySelector<HTMLFieldSetElement>('#calendar-filters')!;
    const rangeFields = document.querySelector<HTMLFieldSetElement>('#range-filters')!;
    const results = document.querySelector('#results')!;
    const status = document.querySelector('#search-status')!;
    const error = document.querySelector<HTMLElement>('#date-error')!;
    function search() {
      const range = mode.value === 'range';
      calendarFields.hidden = range; calendarFields.disabled = range;
      rangeFields.hidden = !range; rangeFields.disabled = !range;
      const invalid = range && !!start.value && !!end.value && start.value > end.value;
      error.hidden = !invalid;
      start.setAttribute('aria-invalid',String(invalid)); end.setAttribute('aria-invalid',String(invalid));
      const filters: SearchFilters = { query: input.value, kind: new FormData(form).get('kind') as string, mode: mode.value, year: year.value, month: month.value, start: start.value, end: end.value };
      const matches = invalid ? [] : filterEntries(entries,filters);
      status.textContent = invalid ? 'Please correct the date range to see results.' : `${matches.length} result${matches.length === 1 ? '' : 's'}${filters.query.trim() ? ` for “${filters.query.trim()}”` : ''}`;
      results.replaceChildren();
      for (const entry of matches) {
        const article = document.createElement('article');
        if (entry.thumbnail) { const link = document.createElement('a'); link.href = entry.url; link.className = 'result-thumbnail'; link.setAttribute('aria-label',`Read ${entry.title}`); const image = document.createElement('img'); image.src = entry.thumbnail; image.alt = entry.thumbnailAlt || ''; image.loading = 'lazy'; link.append(image); article.append(link); }
        const body = document.createElement('div');
        const meta = document.createElement('div'); meta.className = 'eyebrow';
        const date = document.createElement('time'); date.dateTime = entry.date; date.textContent = entry.displayDate; meta.append(`${entry.label} / `,date);
        const heading = document.createElement('h2'); const link = document.createElement('a'); link.href = entry.url; link.textContent = entry.title; heading.append(link);
        const description = document.createElement('p'); description.textContent = entry.description;
        body.append(meta,heading,description); article.append(body); results.append(article);
      }
      if (!invalid && !matches.length) { const message = document.createElement('p'); message.textContent = 'No pages match these filters. Try a broader keyword, another date, or Clear Filters to start again.'; results.append(message); }
      const url = new URL(location.href); url.search = '';
      if (filters.query.trim()) url.searchParams.set('q',filters.query.trim());
      if (filters.kind !== 'all') url.searchParams.set('kind',filters.kind);
      if (range) { url.searchParams.set('mode','range'); if (filters.start) url.searchParams.set('start',filters.start); if (filters.end) url.searchParams.set('end',filters.end); }
      else { if (filters.year) url.searchParams.set('year',filters.year); if (filters.month) url.searchParams.set('month',filters.month); }
      history.replaceState(null,'',url);
    }
    const params = new URLSearchParams(location.search);
    input.value = params.get('q') || '';
    for (const radio of form.querySelectorAll<HTMLInputElement>('input[name="kind"]')) radio.checked = radio.value === (['articles','signals','books'].includes(params.get('kind') || '') ? params.get('kind') : 'all');
    mode.value = params.get('mode') === 'range' ? 'range' : 'calendar';
    year.value = params.get('year') || ''; month.value = params.get('month') || '';
    start.value = params.get('start') || ''; end.value = params.get('end') || '';
    form.addEventListener('input',search); form.addEventListener('change',search);
    form.addEventListener('submit',event => { event.preventDefault(); search(); });
    form.addEventListener('reset',() => { setTimeout(search,0); });
    search();
  </script>
</Base>
<style>
  fieldset{border:0;padding:0;margin:0;min-width:0}legend{font-size:12px;margin-bottom:10px}.type-filters{margin:24px 0;display:flex;gap:10px;flex-wrap:wrap}.type-filters label{margin:0;position:relative}.type-filters input{position:absolute;opacity:0}.type-filters span{display:block;padding:8px 19px;border:1px solid var(--line);cursor:pointer;font-size:12px}.type-filters input:checked+span{background:var(--ink);color:var(--paper);border-color:var(--ink)}.type-filters input:focus-visible+span,select:focus-visible{outline:2px solid var(--rust);outline-offset:3px}.date-heading{display:flex;justify-content:space-between;align-items:end;gap:20px}.date-heading label{flex:1;max-width:360px}.date-fields{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:15px}.date-fields[hidden]{display:none}.search-form select,.date-fields input{display:block;width:100%;min-width:0;background:#fffdf7;color:var(--ink);border:1px solid #898e7e;border-radius:0;padding:12px;font:14px var(--sans);margin-top:8px}.search-form .clear-filters{background:transparent;color:var(--rust);border:1px solid var(--line);padding:12px 18px;margin-bottom:10px}.date-help{font-size:11px;color:var(--muted)}#date-error{font-size:13px;color:var(--rust)}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.search-results :global(article){display:flex;gap:22px;align-items:flex-start}.search-results :global(.result-thumbnail){flex:0 0 120px}.search-results :global(img){width:120px;height:90px;object-fit:cover;display:block}@media(max-width:520px){.date-fields{grid-template-columns:1fr;gap:8px}.date-heading{align-items:stretch;flex-direction:column;gap:5px}.search-form .clear-filters{align-self:flex-start}.type-filters{gap:7px}.type-filters span{padding:8px 14px}.search-results :global(.result-thumbnail){flex-basis:75px}.search-results :global(img){width:75px;height:75px}}
</style>
